  "candidate_window_derivation": {
    "coordinate_system": "stored as 0-based inclusive ranges; user documentation also reports 1-based start and length",
    "starts_1based": "1, x, 2x, 3x, 4x where x is enzyme-specific serial_unit_length",
    "T1_to_T4_length": "min(tag_length + 23, 2 * tag_length - 1); BsaXI therefore reproduces 50 bp",
    "T5_length": "pear_broad_max - 4*x; equivalent to x + 27 under the current broad formula; BsaXI therefore reproduces 60 bp",
    "rationale": "Training-style broad candidate windows: longer than one exact tag and, for T1-T4, shorter than two exact tags. T5 may be longer because there is no sixth tag. Exact tags are recovered later by enzyme-pattern matching."
  }
